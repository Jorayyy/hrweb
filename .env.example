# PostgreSQL (Neon). Pooled endpoint for serverless/Vercel; use the direct
# (non-pooler) endpoint for long-running local scripts if you hit pool exhaustion.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&channel_binding=require"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Field-level encryption for statutory IDs (TIN/SSS/PhilHealth/Pag-IBIG).
# Any passphrase works (hashed to a 32-byte key). REQUIRED in production.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
